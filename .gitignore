# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ningún secreto entra al repositorio.
# .env.example es la única excepción y no contiene valores reales.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase (estado local del stack; la configuración y las migraciones sí se versionan)
/supabase/.temp
/supabase/.branches

# restos del árbol anterior al reinicio del proyecto: solo cachés y artefactos de build
# (.venv, .mypy_cache, node_modules, dist). Se pueden borrar sin perder nada; el código
# original sigue disponible en el historial de git (git show 4cd3d4f:<archivo>).
/backend/
/frontend/

# cache de vitest
/.vitest/

# Claude Code: archivos personales
.claude/settings.local.json
CLAUDE.local.md