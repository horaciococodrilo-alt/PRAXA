APP_ENV=development
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://praxa_app:local-app-only@localhost:5432/praxa
MIGRATION_DATABASE_URL=postgresql+psycopg://praxa_owner:local-owner-only@localhost:5432/praxa
SEED_DATABASE_URL=postgresql+psycopg://postgres:local-bootstrap-only@localhost:5432/postgres
BLOB_STORE_BACKEND=local
BLOB_STORE_PATH=./data/evidence
JWT_ISSUER=praxa-local
EMBEDDING_PROVIDER=fake
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# Never put real credentials or customer data in this file.
# If POSTGRES_HOST_PORT changes, update the port in all three URLs above to match.
