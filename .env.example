APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL: contrasenas del contenedor ------------------------------------------------
# Las tres son obligatorias para `docker compose up`. Copiar este archivo a .env y completarlas
# con valores locales; .env esta ignorado por Git.
POSTGRES_PASSWORD=
PRAXA_OWNER_PASSWORD=
PRAXA_APP_PASSWORD=

# Puerto del host. Cambiarlo solo si la maquina ya tiene un PostgreSQL propio en 5432.
POSTGRES_HOST_PORT=5432

# --- Credenciales separadas por contexto ---------------------------------------------------
# Cada una pertenece a un proceso distinto y no se comparten.

# Rol de aplicacion. Unica credencial que recibe el proceso de API. En VS-01 es de solo lectura.
DATABASE_URL=postgresql+psycopg://praxa_app:@127.0.0.1:5432/praxa

# Rol owner/migracion. Solo Alembic y CI. Ausente del entorno de la API.
MIGRATION_DATABASE_URL=postgresql+psycopg://praxa_owner:@127.0.0.1:5432/praxa

# Superusuario. Solo bootstrap del cluster y semilla de fixtures, en desarrollo y CI.
SEED_DATABASE_URL=postgresql+psycopg://postgres:@127.0.0.1:5432/praxa

# --- Fases posteriores ---------------------------------------------------------------------
BLOB_STORE_BACKEND=local
BLOB_STORE_PATH=./data/evidence
JWT_ISSUER=praxa-local
EMBEDDING_PROVIDER=fake
OTEL_EXPORTER_OTLP_ENDPOINT=

# Never put real credentials or customer data in this file.
