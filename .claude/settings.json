{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format --check *)",
      "Bash(uv run pytest *)",
      "Bash(npm run lint *)",
      "Bash(npm test *)",
      "Bash(npm run build *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(docker compose *)",
      "Bash(uv add *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(*alembic upgrade*)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.development)",
      "Read(/.env.test)",
      "Read(/.env.production)",
      "Read(/secrets/**)",
      "Read(/data/private/**)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git push --force *)"
    ]
  }
}
